EnergyManagementSystem:Sensor,
  HWD_safr_m3h,           !- Field 1
  Meas HWDsafr,           !- Field 2
  Schedule Value;         !- Field 3

EnergyManagementSystem:Actuator,
  HWD_mdot,               !- Field 1
  Cell Ideal Loads Air System, !- Field 2
  Ideal Loads Air System, !- Field 3
  Air Mass Flow Rate;     !- Field 4

EnergyManagementSystem:ProgramCallingManager,
  HWD airflow,            !- Field 1
  InsideHVACSystemIterationLoop, !- Field 2
  HWD_airflow;            !- Field 3

EnergyManagementSystem:Program,
  HWD_airflow,            !- Field 1
  SET HWD_mdot = HWD_safr_m3h * 1.1455 / 3600; !- Field 2

